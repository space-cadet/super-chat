{
  "name": "@super-chat/standalone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "pnpm exec tsc --noEmit",
    "dev:web": "node scripts/build.mjs dev:web",
    "build:web": "node scripts/build.mjs web",
    "preview:web": "vite preview --host 0.0.0.0",
    "add:android": "pnpm exec cap add android",
    "add:desktop": "node scripts/build.mjs add:desktop",
    "sync:android": "node scripts/build.mjs sync:android",
    "run:android": "node scripts/build.mjs run:android",
    "run:desktop": "node scripts/build.mjs run:desktop",
    "open:android": "pnpm exec cap open android",
    "build:android:debug": "node scripts/build.mjs android:debug",
    "build:android:release-apk": "node scripts/build.mjs android:release-apk",
    "build:android:release-aab": "node scripts/build.mjs android:release-aab",
    "build:desktop:mac:dmg:arm64": "node scripts/build.mjs desktop:mac:dmg:arm64",
    "build:desktop:mac:dmg:x64": "node scripts/build.mjs desktop:mac:dmg:x64",
    "build:desktop:mac:zip:arm64": "node scripts/build.mjs desktop:mac:zip:arm64",
    "build:desktop:windows:nsis": "node scripts/build.mjs desktop:windows:nsis",
    "build:desktop:windows:portable": "node scripts/build.mjs desktop:windows:portable",
    "build:desktop:linux:appimage": "node scripts/build.mjs desktop:linux:appimage",
    "build:desktop:linux:deb": "node scripts/build.mjs desktop:linux:deb",
    "clean:web": "node scripts/build.mjs clean:web",
    "clean:android": "node scripts/build.mjs clean:android"
  },
  "dependencies": {
    "@capacitor/app": "7.0.1",
    "@capacitor/core": "7.6.9",
    "@capacitor/device": "7.0.2",
    "@capacitor/network": "7.0.2",
    "@capawesome/capacitor-electron": "0.2.2",
    "@super-chat/desktop-diagnostics": "workspace:*",
    "katex": "^0.16.0",
    "pdfjs-dist": "4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "rehype-katex": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "super-chat": "workspace:*"
  },
  "devDependencies": {
    "@capacitor/android": "7.6.9",
    "@capacitor/cli": "7.6.9",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "tailwindcss": "^4.0.0",
    "typescript": "5.9.3",
    "vite": "6.4.2"
  }
}
